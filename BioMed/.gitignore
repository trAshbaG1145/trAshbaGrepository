# =============================================================================
# BioMed 实验项目
# 原则：忽略可再生成的中间产物、课程原始数据与本机环境文件；
#       保留源码、实验结果（图/表/指标）与报告正文、PDF。
# =============================================================================

# ---------- Python 缓存与虚拟环境 ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- 课程原始数据（可用同名 zip 解压恢复） ----------
Exp1/实验1-数据/
Exp2/实验2-数据/
*.zip
*.rar
*.7z

# 课程提供的实验指导书（二进制参考材料，不入库）
生物医学智能信息处理-实验指导书.docx

# ---------- 自动生成的中间产物 ----------
# Exp2 报告排版检查导出的逐页渲染图
Exp2/report/qa/
# exp2_main.py 重新运行即可生成的模型数组缓存
Exp2/results/*.npz

# ---------- LaTeX / Pandoc 编译中间文件 ----------
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.nav
*.snm
*.vrb

# ---------- 系统与本地配置 ----------
.DS_Store
Thumbs.db
desktop.ini
.env
